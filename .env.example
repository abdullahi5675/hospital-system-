# ── Server ──────────────────────────────────────────────
PORT=5000

# ── PostgreSQL Database ──────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/clinic_db

# ── Session ─────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
SESSION_SECRET=change_this_to_a_long_random_secret_string

# ── Role Registration Codes ──────────────────────────────
# Codes that staff use during registration to claim their role.
# Change these before deploying to production.
ADMIN_REGISTRATION_CODE=your_admin_code_here
DOCTOR_REGISTRATION_CODE=your_doctor_code_here
